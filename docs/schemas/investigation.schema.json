{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigation",
  "type": "object",
  "properties": {
    "brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/Brief"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "handoff": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "hypotheses": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Hypothesis"
      }
    },
    "plan": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanStep"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "updated": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "minimum": 0
    }
  },
  "required": [
    "revision"
  ],
  "$defs": {
    "Brief": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "done_when": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "question"
      ]
    },
    "ConfidenceParam": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "inferred"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceParam"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_ids",
        "confidence"
      ]
    },
    "Hypothesis": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string"
        },
        "contradicting": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "prediction": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
        },
        "supporting": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "claim",
        "status"
      ]
    },
    "HypothesisStatus": {
      "type": "string",
      "enum": [
        "testing",
        "supported",
        "refuted",
        "abandoned"
      ]
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "todo"
        },
        "title": {
          "type": "string"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "StepStatus": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done",
        "blocked"
      ]
    }
  }
}
